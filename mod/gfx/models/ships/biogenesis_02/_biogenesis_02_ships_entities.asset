entity = {
	name = "biogenesis_02_mauler_stage_1_entity"
	pdxmesh = "biogenesis_01_science_ship_frame_mesh"

	default_state = "idle"
	state = { name = "idle"	 animation = "idle" animation_blend_time = 0.25
