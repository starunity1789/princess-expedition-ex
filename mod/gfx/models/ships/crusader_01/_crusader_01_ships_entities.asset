# 皇女的远征军EX · 星体缩小：覆盖 原版的 gfx/models/ships/crusader_01/_crusader_01_ships_entities.asset。
# 由 tools/gen_celestial_scale.py 生成，请勿手改；栖息地：3 个带网格的实体 ×0.1667。

@destroyer_scale = 9.0
@corvette_scale = 8.5
@transport_scale = 9.0
@cruiser_scale = 12.5
@missile_scale = 1.0
@constructor_scale = 12.5
@science_scale = 11.0
@colonizer_scale = 18.0
@military_station_small = 15.0
@mining_station = 13.0
@research_station = 13.0

@small_trail_W = 10
@small_trail_L = 60
@medium_trail_W = 25
@medium_trail_L = 150
@large_trail_W = 50
@large_trail_L =  300

