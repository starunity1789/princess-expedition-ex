		start_event = { trigger_once = yes sound = { soundeffect = "amb_cruiser_hum" } }
	}
	state = { name = "moving" animation = "idle" animation_blend_time = 2
		event = { trigger_once = yes sound = { soundeffect = "moving_out_cruiser" } }
