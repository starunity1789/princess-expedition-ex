# 皇女的远征军EX · 星体缩小：覆盖 原版的 gfx/models/ships/other/_other_entities.asset。
# 由 tools/gen_celestial_scale.py 生成，请勿手改；毁坏的栖息地：1 个带网格的实体 ×0.1667。

@boxy = 2.5

@corvette_scale = 6.5
@nomad_destroyer_scale = 16.0
@space_ark_scale = 19





