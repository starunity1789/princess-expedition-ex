		event = { time = 0.0 node = "dust_locator2" particle = "cylinder_dust_effect" trigger_once = yes keep_particle = yes }
		event = { time = 0.0 node = "dust_locator3" particle = "cylinder_dust_effect" trigger_once = yes keep_particle = yes }
