# 皇女的远征军EX · 星体缩小：覆盖 原版的 gfx/models/ships/megastructures/matter_decompressor/matter_decompressor_01.asset。
# 由 tools/gen_celestial_scale.py 生成，请勿手改；包住恒星的巨构，跟恒星一起缩小：165 个带网格的实体 ×0.125。

entity = {
	name = "matter_decompressor_01_entity"
	pdxmesh = "matter_decompressor_01_mesh"
	
		meshsettings = {
			name = "matter_decompressorShape"
			index = 0
			texture_diffuse = "matter_decompressor_01_diffuse.dds"
			texture_normal = "matter_decompressor_01_normal.dds"
			texture_specular = "matter_decompressor_01_specular.dds"
			shader = "PdxMeshShip"
		}
}

