#### Destroyed Entity ####

entity = {
	name = "mega_art_institution_01_destroyed_entity"
	pdxmesh = "mega_art_institution_01_destroyed_mesh"
			
	locator = { name = "debris"	position = { 0 0 0 } }	

	default_state = "idle"
	state = { name = "idle" state_time = 10
		start_event = { trigger_once = yes sound = { soundeffect = "spy_orb_destroyed" stop_on_state_change = yes } }
	}
	
	attach = { debris = "debris_small_01_entity" }
	scale = 0.1667	# 原版没写（1.0），×0.1667
}

#####################################################
#####											#####
#####					infernal				#####
#####											#####
#####################################################


entity = {
	name = "infernal_01_mega_art_institution_stage_1_entity"
	pdxmesh = "mega_art_institution_01_stage_1_mesh"
	
		meshsettings = {
			name = "polySurface15Shape"
			index = 0
			texture_diffuse = "infernal_01_mega_art_institution_diffuse.dds"
			texture_normal = "infernal_01_mega_art_institution_normal.dds"
			texture_specular = "infernal_01_mega_art_institution_specular.dds"
			shader = "PdxMeshShipDiffuseEmissiveNoise"
		}

		meshsettings = {
			name = "polySurface15Shape"
			index = 1
			texture_diffuse = "infernal_01_mega_art_institution_diffuse.dds"
			texture_normal = "infernal_01_mega_art_institution_normal.dds"
			texture_specular = "infernal_01_mega_art_institution_specular.dds"
			shader = "PdxMeshShipDiffuseEmissiveAlpha"
		}
	
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_speed = 0.7 
		start_event = { node = "part1" particle = "mega_art_core_2_effect" keep_particle = yes trigger_once = yes }

		start_event = { trigger_once = yes sound = { soundeffect = "sfx_mega_art_installation_hum" } }
	}
	
	attach = { part1_upper = "mega_art_fountain_splash_entity" }
	
	game_data = {
		uv_animation_speed 		= @flowmap_speed

		#NOTE: Since the ship makes use of a flowmap, this is a special case
		#where the uv_animation_direction variable is used to determine the flowmap strength
		#instead of an animation direction.
		uv_animation_direction 	= { @flowmap_intensity 0.0 }
		
		emissive_recolor_crunch = 5.0
	}
	scale = 0.1667	# 原版没写（1.0），×0.1667
}

