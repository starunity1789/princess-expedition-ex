# 皇女的远征军EX · 星体缩小：覆盖 原版的 gfx/models/ships/megastructures/mega_art_institution/mega_art_institution_01.asset。
# 由 tools/gen_celestial_scale.py 生成，请勿手改；人造巨构：65 个带网格的实体 ×0.1667。

@flowmap_speed = 0.12
@flowmap_intensity =  0.21

#####################################################
#####											#####
#####				Arthropoid					#####
#####											#####
#####################################################


entity = {
	name = "arthropoid_01_mega_art_institution_stage_1_entity"
	pdxmesh = "mega_art_institution_01_stage_1_mesh"
	
		meshsettings = {
			name = "polySurface15Shape"
			index = 0
			texture_diffuse = "arthropoid_01_mega_art_institution_diffuse.dds"
			texture_normal = "arthropoid_01_mega_art_institution_normal.dds"
			texture_specular = "arthropoid_01_mega_art_institution_specular.dds"
			shader = "PdxMeshShip"
		}
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_speed = 0.7 
		start_event = { node = "part1" particle = "mega_art_core_2_effect" keep_particle = yes trigger_once = yes }

		start_event = { trigger_once = yes sound = { soundeffect = "sfx_mega_art_installation_hum" } }
	}
	
	attach = { part1_upper = "mega_art_fountain_splash_entity" }
	scale = 0.1667	# 原版没写（1.0），×0.1667
}

