		event = { time = 5.0 node = "L_barrel_laser_1" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.1 node = "L_barrel_laser_2" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.1 node = "L_barrel_laser_9" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.2 node = "L_barrel_laser_3" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.2 node = "L_barrel_laser_8" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.3 node = "L_barrel_laser_4" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.3 node = "L_barrel_laser_7" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.4 node = "L_barrel_laser_5" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 5.4 node = "L_barrel_laser_6" particle = "dyson_cannon_01_barrel_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }

		event = { time = 5.0 trigger_once = yes sound = { soundeffect = dyson_gun_barrel_fire_1 stop_on_state_change = yes } }
		event = { time = 5.1 trigger_once = yes sound = { soundeffect = dyson_gun_barrel_fire_2 stop_on_state_change = yes } }
		event = { time = 5.2 trigger_once = yes sound = { soundeffect = dyson_gun_barrel_fire_3 stop_on_state_change = yes } }
		event = { time = 5.3 trigger_once = yes sound = { soundeffect = dyson_gun_barrel_fire_4 stop_on_state_change = yes } }
		event = { time = 5.4 trigger_once = yes sound = { soundeffect = dyson_gun_barrel_fire_5 stop_on_state_change = yes } }

		event = { time = 6.0 node = "L_barrel_1" particle = "dyson_cannon_01_laser_stage_3_effect" keep_particle = yes trigger_once = yes  }

		event = { time = 6.0 sound = { soundeffect = dyson_gun_big_laser_blast } }
		event = { time = 6.0 sound = { soundeffect = dyson_gun_big_blast_bass } }

		event = {	time = 4.0 	node = "wormhole"	entity = "dyson_gun_01_wormhole_chaos_stage_3_entity"	erosion_in = 0.2				erosion_out = 0.4	trigger_once = yes}
		event = {	time = 4.0 	node = "wormhole"	entity = "dyson_gun_01_wormhole_chaos_2_stage_3_entity"	erosion_in = 0.2				erosion_out = 0.4	trigger_once = yes}
		event = {	time = 0.0 	node = "wormhole_effect" particle = "dyson_wormhole_active_stage_3_effect" keep_particle = yes trigger_once = yes  }
	}


	# Idle state when going from opened state to idle.
	state = { name = "idle" animation = "closing" animation_speed = 1 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}

		event = { time = 2.8 sound = { soundeffect = "dyson_gun_small_arms_in" stop_on_state_change = yes } }		

		event = { time = 11.2  sound = { soundeffect = dyson_gun_arms_in_start } }
		event = { time = 14.4  sound = { soundeffect = dyson_gun_arms_in_place_in_lock } }
		event = { time = 14.7  sound = { soundeffect = dyson_gun_arms_in_place } }

		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_stage_3_effect" keep_particle = yes trigger_once = yes  }

		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "dyson_gun_powerdown_shepard_17s" stop_on_state_change = yes } }
		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "dyson_gun_powerdown_shepard_low_17s" stop_on_state_change = yes } }
	}

	# Closed death state.
	state = { name = "death" animation = "closed_death" looping = no animation_speed = 0.5
		event = { time = 2.0 trigger_once = yes sound = { soundeffect = kaiju_adult_death stop_on_state_change = yes } }
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_stage_3_effect" keep_particle = yes trigger_once = yes  }
	}

#	# Opened death state.
#	state = { name = "death" animation = "opened_death" looping = no animation_blend_time = 2 animation_speed = 0.5
#		chance = {
#			if_current_state = {
#				"idle" = 0
#				"moving" = 0
#				"death" = 0
#				"working" = 100
#				"working_looping" = 100
#			}
#		}
#		event = { time = 2.0 trigger_once = yes sound = { soundeffect = ship_destroyed stop_on_state_change = yes } }
#	}

	attach = { wormhole = "dyson_gun_01_wormhole_stage_3_entity" }

	game_data = {
		emissive_recolor_crunch = 3.0
	}
}




