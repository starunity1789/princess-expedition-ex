# 皇女的远征军EX · 星体缩小：覆盖 原版的 gfx/models/ships/megastructures/dyson_gun/dyson_gun_01.asset。
# 由 tools/gen_celestial_scale.py 生成，请勿手改；包住恒星的巨构，跟恒星一起缩小：4 个带网格的实体 ×0.125。

@cull_radius = 100

##### Dyson Gun Stage 1 #####

entity = {
	name = "dyson_gun_01_stage_1_entity"
    pdxmesh = "dyson_gun_01_stage_1_frame_mesh"

default_state = "idle"
state = { name = "idle" animation = "idle_01" looping = no }
state = { name = "death" animation = "closed_death" looping = no }
	
	locator = { name = "part1"	position = { 0 0 0 } }
	
	attach = { part1 = "dyson_gun_01_stage_1_section_entity" }
	
	cull_radius = @cull_radius



	scale = 0.125	# 原版没写（1.0），×0.125
}

entity = {
	name = "dyson_gun_01_stage_1_section_entity"
	pdxmesh = "dyson_gun_01_stage_1_mesh"
			locator = { name = "wormhole"	position = { 0 0 -210 } rotation = { 0 90 0 } }
			locator = { name = "wormhole_effect"	position = { 0 0 -230 } rotation = { 0 90 0 } }

default_state = "idle"
	state = { name = "idle" animation = "idle_01" animation_blend_time = 0 chance = 7.0 looping = no next_state = idle
	
		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0 sound = { soundeffect = hero_ship_idle_loop } }
		event = { time = 0 sound = { soundeffect = wormhole_loop } }
	}
	state = { name = "idle" animation = "idle_02" animation_blend_time = 0.01 chance = 2.0 looping = no next_state = idle
		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_effect" keep_particle = yes trigger_once = yes  }
		event = { time = 0 sound = { soundeffect = hero_ship_idle_loop } }
		event = { time = 0 sound = { soundeffect = wormhole_loop } }
	}


	# Actual moving state if going from idle/moving.
	state = { name = "moving" animation = "idle_01" looping = yes next_state = "moving" animation_blend_time = 0.5
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
		# Extra events for moving state (moved out of chance block)
		# event = { time = 0.87 sound = { soundeffect = kaiju_adult_tail_swish_long_low } }
		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_effect" keep_particle = yes trigger_once = yes  }

	}


	# Opening state, goes into "working_looping" state when done.
	state = { name = "working" animation = "working_start" animation_blend_time = 0.01 looping = no next_state = "working_looping"
		event = { time = 0	id = "beam_start" }

		event = { time = 2.9  sound = { soundeffect = dyson_gun_arms_out_start } }
		event = { time = 3.5  sound = { soundeffect = dyson_gun_arms_in_place } }

		event = { time = 4 node = "ringBack" particle = "dyson_cannon_01_back_stage_1_effect" keep_particle = yes trigger_once = yes }

		event = { time = 4.5 sound = { soundeffect = "dyson_gun_powerup_shepard_loop_low" stop_on_state_change = yes } }

		event = { time = 4.5 sound = { soundeffect = "dyson_gun_small_arms_out" stop_on_state_change = yes } }

		event = { time = 4.5 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 5.2 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 5.9 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 6.6 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 7.3 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 8.0 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 8.7 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 9.4 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 10.1 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 10.8 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 11.5 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 12.2 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 12.9 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 13.6 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 14.3 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 15.0 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 15.7 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 16.4 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 17.1 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 17.8 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }
		event = { time = 18.5 node = "ringBack" sound = { soundeffect = spark_electric stop_on_state_change = yes } }

		event = { time = 8.0 node = "L_coil_3" particle = "dyson_cannon_01_pylon_charge_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 8.2 node = "L_coil_4" particle = "dyson_cannon_01_pylon_charge_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 8.4 node = "L_coil_5" particle = "dyson_cannon_01_pylon_charge_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 8.6 node = "L_coil_6" particle = "dyson_cannon_01_pylon_charge_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 8.8 node = "L_coil_1" particle = "dyson_cannon_01_pylon_charge_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 9.0 node = "L_coil_2" particle = "dyson_cannon_01_pylon_charge_stage_1_effect" keep_particle = yes trigger_once = yes}


		event = { time = 16.0 node = "L_arm_1" particle = "dyson_cannon_01_arm_charge_stage_1_effect" keep_particle = yes trigger_once = yes sound = { soundeffect = dyson_cannon_arm_charge_start_1 stop_on_state_change = yes } }
		event = { time = 16.3 node = "L_arm_2" particle = "dyson_cannon_01_arm_charge_stage_1_effect" keep_particle = yes trigger_once = yes sound = { soundeffect = dyson_cannon_arm_charge_start_1 stop_on_state_change = yes } }
		event = { time = 16.6 node = "L_arm_3" particle = "dyson_cannon_01_arm_charge_stage_1_effect" keep_particle = yes trigger_once = yes sound = { soundeffect = dyson_cannon_arm_charge_start_1 stop_on_state_change = yes } }
		event = { time = 16.9 node = "L_arm_4" particle = "dyson_cannon_01_arm_charge_stage_1_effect" keep_particle = yes trigger_once = yes sound = { soundeffect = dyson_cannon_arm_charge_start_1 stop_on_state_change = yes } }

		event = { time = 16.0 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 17.5 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 19.0 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 20.5 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 22.0 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 23.5 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 25.0 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 26.5 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 28.0 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 29.5 node = "L_arm_1" sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }

#		event = {	time = 0.0 	node = "wormhole"	entity = "dyson_gun_01_wormhole_entity"	erosion_in = 0.2				erosion_out = 0.4	trigger_once = yes}
		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_effect" keep_particle = yes trigger_once = yes  }

	}

	# Opened state, going after "opening animation".
	state = { name = "working_looping" animation = "working_looping"  looping = yes
		chance = {
				if_current_state = {
					"idle" = 0
					"moving" = 0
					"death" = 0
					"working" = 100
					"working_looping" = 100
				}
			}

		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "dyson_gun_powerup_shepard_loop" stop_on_state_change = yes } }
		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "dyson_gun_powerup_shepard_loop_low" stop_on_state_change = yes } }

		event = { time = 0.0 sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 1.5 sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 3.0 sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 4.5 sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 6.0 sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
		event = { time = 7.5 sound = { soundeffect = dyson_arm_laser_2s_fadeinout_0.5s stop_on_state_change = yes } }
			
		event = { time = 0 node = "L_coil_1" particle = "dyson_cannon_01_pylon_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0 node = "L_coil_2" particle = "dyson_cannon_01_pylon_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0 node = "L_coil_3" particle = "dyson_cannon_01_pylon_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0 node = "L_coil_4" particle = "dyson_cannon_01_pylon_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0 node = "L_coil_5" particle = "dyson_cannon_01_pylon_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0 node = "L_coil_6" particle = "dyson_cannon_01_pylon_stage_1_effect" keep_particle = yes trigger_once = yes}

		event = { time = 0 node = "ringBack" particle = "dyson_cannon_01_back_stage_1_effect" keep_particle = yes trigger_once = yes  }

		event = { time = 0.8 node = "L_arm_1" particle = "dyson_cannon_01_arm_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0.8 node = "L_arm_2" particle = "dyson_cannon_01_arm_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0.8 node = "L_arm_3" particle = "dyson_cannon_01_arm_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 0.8 node = "L_arm_4" particle = "dyson_cannon_01_arm_stage_1_effect" keep_particle = yes trigger_once = yes}

		event = { time = 1000 id = "beam_start" } #will never fire, but lets the game know that an event with this ID exists

		event = { time = 3.5 node = "L_ring_1" particle = "dyson_cannon_01_ring_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 3.5 node = "L_ring_2" particle = "dyson_cannon_01_ring_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 3.5 node = "L_ring_3" particle = "dyson_cannon_01_ring_stage_1_effect" keep_particle = yes trigger_once = yes}
		event = { time = 3.5 node = "L_ring_4" particle = "dyson_cannon_01_ring_stage_1_effect" keep_particle = yes trigger_once = yes}

		event = { time = 3.5 node = "L_barrel" particle = "dyson_cannon_01_laser_stage_1_effect" keep_particle = yes trigger_once = yes}

		event = { time = 3.5 sound = { soundeffect = dyson_gun_big_laser_blast } }
		event = { time = 3.5 sound = { soundeffect = dyson_gun_big_blast_bass } }

#		event = {	time = 0.0 	node = "wormhole"	entity = "dyson_gun_01_wormhole_entity"	erosion_in = 0.2				erosion_out = 0.4	trigger_once = yes}
		event = {	time = 4.0 	node = "wormhole"	entity = "dyson_gun_01_wormhole_chaos_entity"	erosion_in = 0.2				erosion_out = 0.4	trigger_once = yes}
		event = {	time = 4.0 	node = "wormhole"	entity = "dyson_gun_01_wormhole_chaos_2_entity"	erosion_in = 0.2				erosion_out = 0.4	trigger_once = yes}
		event = {	time = 0.0 	node = "wormhole_effect" particle = "dyson_wormhole_active_effect" keep_particle = yes trigger_once = yes  }

	}


	# Idle state when going from opened state to idle.
	state = { name = "idle" animation = "closing" animation_speed = 1 looping = no next_state = "idle"
		chance = {
			if_current_state = {
				"idle" = 0
				"moving" = 0
				"death" = 0
				"working" = 100
				"working_looping" = 100
			}
		}

		event = { time = 2.8 sound = { soundeffect = "dyson_gun_small_arms_in" stop_on_state_change = yes } }

		event = { time = 11.2  sound = { soundeffect = dyson_gun_arms_in_start } }
		event = { time = 14.4  sound = { soundeffect = dyson_gun_arms_in_place_in_lock } }
		event = { time = 14.7  sound = { soundeffect = dyson_gun_arms_in_place } }		
		
		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_effect" keep_particle = yes trigger_once = yes  }

		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "dyson_gun_powerdown_shepard_17s" stop_on_state_change = yes } }
		event = { time = 0.0 trigger_once = yes sound = { soundeffect = "dyson_gun_powerdown_shepard_low_17s" stop_on_state_change = yes } }
		
	}

	# Closed death state.
	state = { name = "death" animation = "closed_death" looping = no animation_speed = 0.5
		event = { time = 2.0 trigger_once = yes sound = { soundeffect = kaiju_adult_death stop_on_state_change = yes } }
		chance = {
			if_current_state = {				"idle" = 100
				"moving" = 100
				"death" = 0
				"working" = 0
				"working_looping" = 0
			}
		}
		event = { time = 0 node = "wormhole_effect" particle = "dyson_wormhole_effect" keep_particle = yes trigger_once = yes  }
		event = { trigger_once = yes sound = { soundeffect = "" } }

	}
#	# Opened death state.
#	state = { name = "death" animation = "opened_death" looping = no animation_blend_time = 2 animation_speed = 0.5
#		chance = {
#			if_current_state = {
#				"idle" = 0
#				"moving" = 0
#				"death" = 0
#				"working" = 100
#				"working_looping" = 100
#			}
#		}
#		event = { time = 2.0 trigger_once = yes sound = { soundeffect = ship_destroyed stop_on_state_change = yes } }
#	}




		game_data = {
			emissive_recolor_crunch = 3.0
		}
		
	attach = { wormhole = "dyson_gun_01_wormhole_entity" }

	}




##### Dyson Gun Stage 2 #####

