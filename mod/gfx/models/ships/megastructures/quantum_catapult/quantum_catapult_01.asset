# 皇女的远征军EX · 星体缩小：覆盖 原版的 gfx/models/ships/megastructures/quantum_catapult/quantum_catapult_01.asset。
# 由 tools/gen_celestial_scale.py 生成，请勿手改；包住恒星的巨构，跟恒星一起缩小：64 个带网格的实体 ×0.125。

@quantum_catapult_size = 400

#####################################################
#####											#####
#####					Nemesis					#####
#####											#####
#####################################################


entity = {
	name = "nemesis_01_quantum_catapult_stage_1_entity"
	pdxmesh = "quantum_catapult_stage_1_mesh"

	locator = { name = "root"	position = { 0 0 0 } }

	attach = { root = "quantum_catapult_stage_1_lightning_entity" }

	meshsettings = {
		name = "g_bodyShape"
		index = 0
		texture_diffuse = "nemesis_01_quantum_catapult_diffuse.dds"
		texture_normal = "nemesis_01_quantum_catapult_normal.dds"
		texture_specular = "nemesis_01_quantum_catapult_specular.dds"
		shader = "PdxMeshShip"
	}

	game_data = {
		size = @quantum_catapult_size
	}
	scale = 0.125	# 原版没写（1.0），×0.125
}

