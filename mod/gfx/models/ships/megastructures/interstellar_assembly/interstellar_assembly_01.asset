entity = {
	name = "infernal_01_interstellar_assembly_stage_1_entity"
	pdxmesh = "interstellar_assembly_01_stage_1_mesh"
	
	default_state = "idle"
	state = { name = "idle" animation = "idle" animation_speed = 0.2  
#		start_event = { node = "effect_1" particle = "interstellar_assembly_effect" keep_particle = yes trigger_once = yes }

		start_event = { trigger_once = yes sound = { soundeffect = "sfx_interstellar_assembly_hum" } }
	}
	
		meshsettings = {
			name = "body_1Shape"
			index = 0
			texture_diffuse = "infernal_01_interstellar_assembly_diffuse.dds"
			texture_normal = "infernal_01_interstellar_assembly_normal.dds"
			texture_specular = "infernal_01_interstellar_assembly_specular.dds"
			shader = "PdxMeshShipDiffuseEmissiveNoise"
		}


	attach = { ring_1 = "hologram_effect_entity" }
	attach = { ring_1 = "interstellar_assembly_effect_2_entity" }
	
		game_data = {
			emissive_recolor_crunch = 2.0
			
			uv_animation_speed 		= @flowmap_speed

			#NOTE: Since the ship makes use of a flowmap, this is a special case
			#where the uv_animation_direction variable is used to determine the flowmap strength
			#instead of an animation direction.
			uv_animation_direction 	= { @flowmap_intensity 0.0 }
		}	
	scale = 0.1667	# 原版没写（1.0），×0.1667
}

