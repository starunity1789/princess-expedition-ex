# 皇女的远征军EX · 星体缩小：覆盖 原版的 gfx/models/ships/megastructures/interstellar_assembly/interstellar_assembly_01.asset。
# 由 tools/gen_celestial_scale.py 生成，请勿手改；人造巨构：87 个带网格的实体 ×0.1667。

@flowmap_speed = 0.17
@flowmap_intensity =  0.3

entity = {
	name = "interstellar_assembly_01_entity"
	pdxmesh = "interstellar_assembly_01_mesh"

	scale = 0.1667	# 原版没写（1.0），×0.1667
}

###########


